# =========================================================
# Onda — Docker Compose environment
# Copie para `.env` e preencha antes de `docker compose up`.
# =========================================================

# URL pública do app, usada nos links de convite.
# Em produção, use HTTPS. Para teste local: http://localhost:8080
APP_PUBLIC_URL=https://onda.example.com

# URL pública do LiveKit para o navegador.
# Em produção deve ser WSS (TLS). Para teste local: ws://localhost:7880
LIVEKIT_PUBLIC_URL=wss://livekit.example.com

# Domínios usados apenas pelo overlay opcional do Caddy (docker-compose.tls.yml)
ONDA_DOMAIN=onda.example.com
LIVEKIT_DOMAIN=livekit.example.com

# Gere um par de chaves com:
# docker run --rm livekit/livekit-server generate-keys
# O secret deve ter pelo menos 32 caracteres (o generate-keys já faz isso).
LIVEKIT_API_KEY=troque-pela-api-key
LIVEKIT_API_SECRET=troque-pelo-api-secret
LIVEKIT_TOKEN_TTL_HOURS=6

# Capacidade por sala no modo SFU.
MAX_PARTICIPANTS=25

# LiveKit tenta descobrir o IP público via STUN. Em uma VM com IP público,
# normalmente true. Se a descoberta falhar, descomente a alternativa no
# docker-compose e defina o IP manualmente.
LIVEKIT_USE_EXTERNAL_IP=true

# TURN (Coturn). Use o host/IP público alcançável pelos convidados.
TURN_URL=turn:turn.example.com:3478?transport=udp
TURN_USERNAME=onda
TURN_PASSWORD=troque-por-uma-senha-longa
TURN_EXTERNAL_IP=203.0.113.10
TURN_REALM=onda

# Porta e interface do app no host.
APP_PORT=8080
APP_BIND=0.0.0.0
LIVEKIT_BIND=0.0.0.0
