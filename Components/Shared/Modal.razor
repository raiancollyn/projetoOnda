@if (IsOpen)
{
    <div class="modal-backdrop" tabindex="-1"
         @onpointerdown="HandleBackdropPointerDown"
         @onpointercancel="ResetBackdropPointer"
         @onclick="HandleBackdropClick"
         @onkeydown="HandleKeyDown">
        <div class="modal-card @(Wide ? "modal-wide" : null)"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@_titleId"
             @onpointerdown="HandleCardPointerDown"
             @onpointerdown:stopPropagation="true"
             @onclick:stopPropagation="true">
            <div class="modal-heading">
                <div class="modal-heading-copy">
                    @if (!string.IsNullOrWhiteSpace(Eyebrow))
                    {
                        <span class="eyebrow modal-eyebrow">@Eyebrow</span>
                    }
                    <h2 id="@_titleId">@Title</h2>
                </div>
                @if (Dismissible)
                {
                    <button type="button" class="icon-button modal-close-button" aria-label="Fechar" @onclick="CloseAsync">
                        <Icon Name="x" Size="19" />
                    </button>
                }
            </div>
            @ChildContent
        </div>
    </div>
}

@code {
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";
    private bool _pointerDownOnBackdrop;

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public bool Wide { get; set; }

    [Parameter]
    public bool Dismissible { get; set; } = true;

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private void HandleBackdropPointerDown() => _pointerDownOnBackdrop = true;

    private void HandleCardPointerDown() => _pointerDownOnBackdrop = false;

    private void ResetBackdropPointer() => _pointerDownOnBackdrop = false;

    private Task HandleBackdropClick()
    {
        if (!Dismissible)
        {
            return Task.CompletedTask;
        }

        // Se o ponteiro começou dentro do modal e o usuário arrastou até
        // soltar fora, o navegador dispara o clique no backdrop. Não fecha.
        if (!_pointerDownOnBackdrop)
        {
            return Task.CompletedTask;
        }

        _pointerDownOnBackdrop = false;
        return CloseAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (Dismissible && args.Key == "Escape")
        {
            await CloseAsync();
        }
    }
}
