    private async Task LeaveRoomAsync()
    {
        if (_leaveBusy)
        {
            return;
        }

        _leaveBusy = true;
        try
        {
            if (_jsModule is not null)
            {
                try
                {
                    await _jsModule.InvokeVoidAsync("disposeRoom");
                }
                catch (Exception ex) when (ex is JSException or JSDisconnectedException)
                {
                    // Navigation can continue even if the media cleanup failed.
                }
            }

            Rooms.LeaveRoom(Code, Guest.Id, closeIfEmpty: true);
            _joined = false;
        }
        finally
        {
            _leaveBusy = false;
            Nav.NavigateTo("/");
        }
    }

