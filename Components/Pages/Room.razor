    [JSInvokable]
    public Task OnAudioPlaybackBlocked(bool blocked)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        if (_audioBlocked != blocked)
        {
            _audioBlocked = blocked;
            _ = InvokeAsync(StateHasChanged);
        }

        return Task.CompletedTask;
    }

    [JSInvokable]
    public Task OnMediaError(string context, string message)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        Toasts.Show(string.IsNullOrWhiteSpace(message) ? "Não foi possível acessar esse dispositivo." : message, ToastKind.Error, 6500);
        return Task.CompletedTask;
    }

