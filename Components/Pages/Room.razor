    private async Task SaveQualityAsync()
    {
        _screenQuality = _qualityDraft.Clone().Normalize();
        _qualityDraft = _screenQuality.Clone();
        _showQualityDialog = false;

        try
        {
            var json = JsonSerializer.Serialize(_screenQuality, QualityJsonOptions);
            await JS.InvokeAsync<bool>("onda.saveScreenQuality", json);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // The current session still keeps the values in memory.
        }

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("setScreenQuality", ToJsQuality(_screenQuality));
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                Toasts.Show("As preferências foram salvas, mas não puderam ser aplicadas agora.", ToastKind.Error);
                return;
            }
        }

        Toasts.Show("Ajustes de transmissão salvos para o próximo compartilhamento.", ToastKind.Success);
    }

