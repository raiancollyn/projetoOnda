    private async Task RefreshWebAudioAsync()
    {
        if (_jsModule is null)
        {
            return;
        }

        _audioRouteBusy = true;
        StateHasChanged();
        try
        {
            var settings = await _jsModule.InvokeAsync<WebAudioSettings>("getAudioSettings");
            _audioInputDevices = settings?.Inputs ?? [];
            _audioOutputDevices = settings?.Outputs ?? [];
            _audioInputDeviceId = settings?.InputDeviceId ?? string.Empty;
            _audioOutputDeviceId = settings?.OutputDeviceId ?? string.Empty;
            _audioInputVolume = (int)Math.Round(Math.Clamp(settings?.InputVolume ?? 1, 0, 1) * 100);
            _audioOutputVolume = (int)Math.Round(Math.Clamp(settings?.OutputVolume ?? 1, 0, 1) * 100);
            _audioCanSelectOutput = settings?.CanSelectOutput ?? false;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _audioInputDevices = [];
            _audioOutputDevices = [];
            Toasts.Show("Não foi possível listar os dispositivos de áudio.", ToastKind.Error);
        }
        finally
        {
            _audioRouteBusy = false;
            StateHasChanged();
        }
    }

    private async Task ChangeAudioInputAsync(ChangeEventArgs args)
    {
        if (_jsModule is null || _audioRouteBusy)
        {
            return;
        }

        var deviceId = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(deviceId))
        {
            return;
        }

        _audioRouteBusy = true;
        try
        {
            await _jsModule.InvokeVoidAsync("switchAudioInput", deviceId);
            await RefreshWebAudioAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            Toasts.Show("Não foi possível trocar o microfone.", ToastKind.Error);
        }
        finally
        {
            _audioRouteBusy = false;
            StateHasChanged();
        }
    }

