        {
            _audioOutputVolume = await JS.InvokeAsync<int>("onda.getNativeOutputVolume");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _audioOutputVolume = 100;
        }
    }

    private async Task ApplyNativeOutputVolumeAsync()
    {
        if (!_audioNativeMode)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("onda.setNativeOutputVolume", _audioOutputVolume);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            Toasts.Show("Não foi possível alterar o volume.", ToastKind.Error);
        }
