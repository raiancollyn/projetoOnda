    private static string CameraLabel(CameraDeviceView device)
    {
        var facing = device.Facing switch
        {
            "environment" => "Traseira",
            "user" => "Frontal",
            _ => null
        };

        if (string.IsNullOrWhiteSpace(facing))
        {
            return device.Label;
        }

        var label = device.Label.ToLowerInvariant();
        var alreadyDescribesFacing = device.Facing == "environment"
            ? label.Contains("traseira") || label.Contains("back") || label.Contains("rear") ||
              label.Contains("environment")
            : label.Contains("frontal") || label.Contains("front") || label.Contains("user");

        return alreadyDescribesFacing ? device.Label : $"{facing} · {device.Label}";
    }

