    private int GetVolume(string channel, string peerId)
    {
        var values = channel == ScreenChannel ? _screenVolumes : _voiceVolumes;
        return values.TryGetValue(peerId, out var value) ? value : 80;
    }

    private string VolumeIconFor(string peerId)
    {
        if (GetVolume(VoiceChannel, peerId) == 0 && GetVolume(ScreenChannel, peerId) == 0)
        {
            return "volume-off";
        }

        return GetVolume(VoiceChannel, peerId) == 0 ? "volume-off" : "volume";
    }

    private void ChangeVolume(string peerId, string channel, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var value))
        {
            return;
        }

        SetVolume(peerId, channel, Math.Clamp(value, 0, 100));
    }

    private void ToggleMute(string peerId, string channel)
    {
        var current = GetVolume(channel, peerId);
        SetVolume(peerId, channel, current == 0 ? 80 : 0);
    }

    private void SetVolume(string peerId, string channel, int value)
    {
        var values = channel == ScreenChannel ? _screenVolumes : _voiceVolumes;
        values[peerId] = value;
        _ = ApplyVolumeAsync(peerId, channel, value);
        StateHasChanged();
    }

    private async Task ApplyVolumeAsync(string peerId, string channel, int value)
    {
        if (_jsModule is null)
        {
            return;
        }

        try
        {
            await _jsModule.InvokeVoidAsync("setPeerVolume", peerId, channel, value / 100.0);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // Volume will be re-applied when the next audio track arrives.
        }
    }

    private async Task PushInitialVolumesAsync()
    {
        if (_jsModule is null || _room is null)
        {
            return;
        }

        foreach (var participant in _room.Participants.Where(p => p.Id != Guest.Id))
        {
            try
            {
                await _jsModule.InvokeVoidAsync("setPeerVolume", participant.Id, VoiceChannel, GetVolume(VoiceChannel, participant.Id) / 100.0);
                await _jsModule.InvokeVoidAsync("setPeerVolume", participant.Id, ScreenChannel, GetVolume(ScreenChannel, participant.Id) / 100.0);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                break;
            }
        }
    }

    private async Task SendChatAsync()
    {
        if (_chatSending || _room is null)
        {
            return;
        }

        _chatError = null;
        if (!InputRules.TryNormalizeChat(_chatDraft, out _, out var validationError))
        {
            _chatError = validationError;
            return;
        }

        _chatSending = true;
        try
        {
            if (Rooms.SendChatMessage(Code, Guest.Id, _chatDraft, out var error))
            {
                _chatDraft = string.Empty;
                _scrollChatPending = true;
                _unreadChat = 0;
            }
            else
            {
                _chatError = error ?? "Não foi possível enviar a mensagem.";
            }
        }
        finally
        {
            _chatSending = false;
            StateHasChanged();
        }
    }

    private async Task ScrollChatAsync()
    {
        if (!_scrollChatPending)
        {
            return;
        }

        _scrollChatPending = false;
        if (!_showChat)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("onda.scrollToBottom", _chatMessagesRef);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // Scrolling is a progressive enhancement.
        }
    }

    private async Task JoinFromGateAsync()
    {
        if (_joining || _roomInfo is null)
        {
            return;
        }

        _joining = true;
        _gateError = null;
        try
        {
            await Task.Delay(180);
            var result = Rooms.JoinRoom(Code, Guest.Id, Guest.AvatarTone, Guest.Name, _gatePassword);
            if (result.Status == JoinRoomStatus.Success && result.Room is not null)
            {
                EnterRoom(result.Room);
            }
            else
            {
                _gateError = result.Error ?? "Não foi possível entrar na sala.";
                _roomInfo = Rooms.GetRoomInfo(Code, Guest.Id) ?? _roomInfo;
            }
        }
        finally
        {
            _joining = false;
            StateHasChanged();
        }
    }

    private Task JoinWithoutPasswordAsync() => JoinRoomWithoutPasswordCoreAsync();

