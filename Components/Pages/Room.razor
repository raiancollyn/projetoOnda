    private async Task OpenAudioRouteDialogAsync()
    {
        if (!_nativeMedia && _jsModule is null)
        {
            return;
        }

        _audioNativeMode = _nativeMedia;
        _showAudioRouteDialog = true;
        if (_nativeMedia)
