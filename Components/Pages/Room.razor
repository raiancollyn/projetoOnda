    private Task SaveNameAsync()
    {
        if (!Guest.TrySetName(_nameDraft, out var error))
        {
            _nameError = error;
            return Task.CompletedTask;
        }

        if (_joined && _self is not null)
        {
            if (!Rooms.RenameParticipant(Code, Guest.Id, Guest.Name, out var renameError))
            {
                Toasts.Show(renameError ?? "Não foi possível atualizar seu nome.", ToastKind.Error);
                _showNameDialog = false;
                return Task.CompletedTask;
            }
        }

        _showNameDialog = false;
        Toasts.Show("Nome atualizado.", ToastKind.Success);
        return Task.CompletedTask;
    }

