    private async Task OpenQualityDialog()
    {
        _qualityDraft = _screenQuality.Clone();
        _cameraQualityDraft = _cameraQuality.Clone();
        _qualityTab = "screen";
        _showQualityDialog = true;
        await DetectCapabilitiesAsync();
    }

    private async Task DetectCapabilitiesAsync()
    {
        if (_jsModule is null)
        {
            return;
        }

        _capabilitiesLoading = true;
        StateHasChanged();

        try
        {
            _screenCapabilities = await _jsModule.InvokeAsync<TrackCapabilitiesView>("getScreenCapabilities");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _screenCapabilities = null;
        }

        try
        {
            _cameraCapabilities = await _jsModule.InvokeAsync<TrackCapabilitiesView>("getCameraCapabilities");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _cameraCapabilities = null;
        }

        if (_screenCapabilities is not null)
        {
            _qualityDraft.Height = ClampHeight(
                _qualityDraft.Height,
                ScreenHeightOptions,
                720);
            _qualityDraft.FrameRate = ClampFrameRate(
                _qualityDraft.FrameRate,
                ScreenFrameRateOptions,
                30);
        }

        if (_cameraCapabilities is not null)
        {
            _cameraQualityDraft.Height = ClampHeight(
                _cameraQualityDraft.Height,
                CameraHeightOptions,
                720);
            _cameraQualityDraft.FrameRate = ClampFrameRate(
                _cameraQualityDraft.FrameRate,
                CameraFrameRateOptions,
                30);
        }

        _capabilitiesLoading = false;
        StateHasChanged();
    }

    private void SetQualityTab(string tab)
    {
        _qualityTab = tab == "camera" ? "camera" : "screen";
    }

    private bool IsScreenPresetAvailable(string preset)
    {
        if (_screenCapabilities is null)
        {
            return true;
        }

        var quality = ScreenShareQuality.ForPreset(preset);
        return quality.Height <= _screenCapabilities.MaxHeight &&
            quality.FrameRate <= _screenCapabilities.MaxFrameRate;
    }

