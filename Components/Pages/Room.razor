    private void OnQualityBitrateInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var bitrate))
        {
            _qualityDraft.BitrateKbps = Math.Clamp(bitrate, 800, 20_000);
            _qualityDraft.Preset = ScreenShareQuality.PresetCustom;
        }
    }

    private void OnCameraBitrateInput(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var bitrate))
        {
            _cameraQualityDraft.BitrateKbps = Math.Clamp(bitrate, 300, 12_000);
        }
    }

    private async Task SaveQualityAsync()
    {
        var previousCodec = _screenQuality.Codec;
        _screenQuality = _qualityDraft.Clone().Normalize();
        _cameraQuality = _cameraQualityDraft.Clone().Normalize();
        var codecChanged = !string.Equals(previousCodec, _screenQuality.Codec, StringComparison.OrdinalIgnoreCase);
        _qualityDraft = _screenQuality.Clone();
        _cameraQualityDraft = _cameraQuality.Clone();
        _showQualityDialog = false;

        try
        {
            var screenJson = JsonSerializer.Serialize(_screenQuality, QualityJsonOptions);
            var cameraJson = JsonSerializer.Serialize(_cameraQuality, QualityJsonOptions);
            await JS.InvokeAsync<bool>("onda.saveScreenQuality", screenJson);
            await JS.InvokeAsync<bool>("onda.saveCameraQuality", cameraJson);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            // The current session still keeps the values in memory.
        }

        var screenApplied = false;
        var cameraApplied = false;
        var failed = false;

        if (_jsModule is not null)
        {
            try
            {
                screenApplied = await _jsModule.InvokeAsync<bool>(
                    "setScreenQuality",
                    ToJsQuality(_screenQuality));
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                failed = true;
            }

            try
            {
                cameraApplied = await _jsModule.InvokeAsync<bool>(
                    "setCameraQuality",
                    ToJsCameraQuality(_cameraQuality));
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                failed = true;
            }
        }

        if (_localScreenOn || _localCameraOn)
        {
            var appliedAll = (!_localScreenOn || screenApplied) &&
                (!_localCameraOn || cameraApplied) &&
                !failed;

            if (appliedAll)
            {
                var message = _localScreenOn && codecChanged
                    ? (_isSfu
                        ? "Ajustes aplicados à transmissão atual. O novo codec será usado no próximo compartilhamento."
                        : "Ajustes aplicados à transmissão atual. O novo codec será usado quando você entrar novamente na sala.")
                    : "Ajustes aplicados à transmissão atual.";

                Toasts.Show(message, ToastKind.Success);
            }
            else
            {
                Toasts.Show(
                    "As preferências foram salvas, mas não puderam ser aplicadas integralmente agora.",
                    ToastKind.Error);
            }

            return;
        }

        Toasts.Show(
            "Preferências de tela e câmera salvas para os próximos compartilhamentos.",
            ToastKind.Success);
    }

    private void CloseNameDialog() => _showNameDialog = false;

    private Task SaveNameAsync()
    {
        if (!Guest.TrySetName(_nameDraft, out var error))
        {
            _nameError = error;
            return Task.CompletedTask;
        }

        if (_joined && _self is not null)
        {
            if (!Rooms.RenameParticipant(Code, Guest.Id, Guest.Name, out var renameError))
            {
                Toasts.Show(renameError ?? "Não foi possível atualizar seu nome.", ToastKind.Error);
                _showNameDialog = false;
                return Task.CompletedTask;
            }
        }

        _showNameDialog = false;
        Toasts.Show("Nome atualizado.", ToastKind.Success);
        return Task.CompletedTask;
    }

    private static string StatusLabel(ParticipantView participant)
    {
        if (participant.Speaking)
        {
            return "Falando agora";
        }

        if (participant.ScreenOn)
        {
            return "Compartilhando a tela";
        }

        if (participant.CameraOn)
        {
            return "Câmera ligada";
        }

        return participant.MicOn ? "Microfone ligado" : "Silenciado";
    }

    private static string PeopleCountLabel(int count) =>
        count == 1 ? "1 pessoa" : $"{count} pessoas";

    private static string FormatTime(DateTimeOffset timestamp) =>
        timestamp.ToLocalTime().ToString("HH:mm");

    public async ValueTask DisposeAsync()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        Rooms.RoomChanged -= HandleRoomChanged;
        Rooms.ChatChanged -= HandleChatChanged;
        Rooms.SignalReceived -= HandleSignal;

        if (_joined)
        {
            Rooms.LeaveRoom(Code, Guest.Id);
            _joined = false;
        }

        await ReleaseWakeLockAsync();
        await StopPresenceHeartbeatAsync();
        await StopNativeCallAsync();

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("disposeRoom");
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                // The circuit may already be disconnected.
            }

            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or InvalidOperationException)
            {
                // Ignore teardown failures.
            }
        }

        _dotNetRef?.Dispose();
    }

