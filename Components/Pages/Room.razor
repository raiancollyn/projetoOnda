    private async Task RefreshCameraOptionsAsync()
    {
        if (_jsModule is null || !_localCameraOn)
        {
            return;
        }

        try
        {
            var options = await _jsModule.InvokeAsync<CameraOptionsView>("getCameraOptions");
            if (options is null)
            {
                return;
            }

            _cameraDevices = options.Devices ?? [];
            _cameraTorchSupported = options.TorchSupported;
            _cameraTorchOn = options.TorchOn;
            _cameraOptionsError = null;

            var active = options.ActiveDeviceId;
            if (string.IsNullOrWhiteSpace(active) ||
                !_cameraDevices.Any(device => device.DeviceId == active))
            {
                active = _cameraDevices.FirstOrDefault()?.DeviceId ?? string.Empty;
            }

            _currentCameraId = active;
            _activeCameraId = active;
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _cameraOptionsError = "Não foi possível consultar as câmeras.";
        }

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private async Task SwitchCameraAsync()
    {
        if (_jsModule is null ||
            _cameraOptionsBusy ||
            string.IsNullOrWhiteSpace(_activeCameraId) ||
            _activeCameraId == _currentCameraId)
        {
            return;
        }

        var target = _activeCameraId;
        _cameraOptionsBusy = true;
        _cameraOptionsError = null;
        try
        {
            var changed = await _jsModule.InvokeAsync<bool>("switchCamera", target);
            if (!changed)
            {
                _cameraOptionsError = "Não foi possível trocar a câmera. Verifique a permissão do navegador.";
                _activeCameraId = _currentCameraId;
            }

            await RefreshCameraOptionsAsync();
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _cameraOptionsError = "Não foi possível trocar a câmera.";
            _activeCameraId = _currentCameraId;
        }
        finally
        {
            _cameraOptionsBusy = false;
            StateHasChanged();
        }
    }

    private async Task ToggleCameraTorchAsync(ChangeEventArgs args)
    {
        if (_jsModule is null || _cameraOptionsBusy)
        {
            return;
        }

        var enabled = args.Value is bool value && value;
        _cameraOptionsBusy = true;
        _cameraOptionsError = null;
        try
        {
            var changed = await _jsModule.InvokeAsync<bool>("setCameraTorch", enabled);
            if (changed)
            {
                _cameraTorchOn = enabled;
            }
            else
            {
                _cameraTorchOn = !enabled;
                _cameraOptionsError = "Esta câmera não permitiu alterar a lanterna.";
            }
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException)
        {
            _cameraTorchOn = !enabled;
            _cameraOptionsError = "Não foi possível alterar a lanterna.";
        }
        finally
        {
            _cameraOptionsBusy = false;
            StateHasChanged();
        }
    }

