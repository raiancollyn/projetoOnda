    [JSInvokable]
    public Task OnLocalMediaStateChanged(bool micOn, bool hasMic, bool cameraOn, bool screenOn, bool screenWithAudio)
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        _localMicOn = micOn;
        _hasMic = hasMic;
        var wasCameraOn = _localCameraOn;
        _localCameraOn = cameraOn;
        var wasScreenOn = _localScreenOn;
        var hadScreenAudio = _localScreenWithAudio;
        _localScreenOn = screenOn;
        _localScreenWithAudio = screenWithAudio;

        if (cameraOn && !wasCameraOn)
        {
            _ = RefreshCameraOptionsAsync();
        }
        else if (!cameraOn && !_cameraOptionsBusy)
        {
            _showCameraDialog = false;
            _cameraDevices = [];
            _activeCameraId = string.Empty;
            _currentCameraId = string.Empty;
            _cameraTorchSupported = false;
            _cameraTorchOn = false;
            _cameraOptionsError = null;
        }

        if (!screenOn)
        {
            _localScreenAudioEnabled = false;
            _screenAudioWarningShown = false;
        }
        else if (!wasScreenOn || (!hadScreenAudio && screenWithAudio))
        {
            _localScreenAudioEnabled = screenWithAudio;
        }

        if (screenOn && screenWithAudio)
        {
            _screenAudioWarningShown = false;
        }
        else if (screenOn && _isFirefox && !_screenAudioWarningShown)
        {
            _screenAudioWarningShown = true;
            Toasts.Show(
                "O Firefox não captura áudio da tela. O microfone continua funcionando; para transmitir som, use Chrome ou Edge.",
                ToastKind.Info);
        }

        if (_joined)
        {
            Rooms.UpdateMediaState(Code, Guest.Id, micOn, cameraOn, screenOn, screenWithAudio);
        }

        _ = InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

